{
  "name": "flatcube",
  "private": true,
  "version": "0.1.0",
  "description": "A 3×3 cube laid out flat as an open box, with notation, facelets and a Vue board",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikdoro/flatcube.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./board": "./src/board/index.ts",
    "./vue": "./src/vue/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "cube-terminology.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.9.1",
    "cubejs": "^1.3.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
